{
  "name": "soybean-admin",
  "version": "3.0.0-beta.0",
  "private": true,
  "description": "A fresh and elegant admin template, based on ubean (Hono + Vite) + Vean (@vean/ui) + Vue 3 + TypeScript. 一个基于 ubean 全栈框架与 Vean 组件库的清新优雅的中后台模版。",
  "keywords": [
    "admin",
    "fullstack",
    "hono",
    "typescript",
    "ubean",
    "vean",
    "vite-plus",
    "vue3"
  ],
  "homepage": "https://github.com/soybeanjs/soybean-admin",
  "bugs": {
    "url": "https://github.com/soybeanjs/soybean-admin/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Soybean",
    "email": "soybeanjs@outlook.com",
    "url": "https://github.com/honghuangdc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/soybeanjs/soybean-admin.git"
  },
  "type": "module",
  "scripts": {
    "analyze": "ubean analyze --out benchmarks/bundle-baseline.json",
    "analyze:check": "ubean analyze --check benchmarks/bundle-baseline.json --write=false",
    "build": "vp build",
    "cleanup": "soy cleanup",
    "commit": "soy git-commit",
    "dev": "vp dev",
    "fmt": "vp fmt",
    "lint": "vp lint --fix && eslint --fix .",
    "lint:vue": "eslint . --ext .vue",
    "prepare": "vp config --no-agent",
    "preview": "vp preview",
    "release": "soy release",
    "remove:i18n": "node scripts/remove-i18n.ts",
    "test": "vitest run",
    "test:e2e": "PW_E2E=1 vitest run test/e2e.test.ts",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit --skipLibCheck",
    "upkg": "soy ncu"
  },
  "dependencies": {
    "@antv/g6": "^5.1.1",
    "@iconify/vue": "^5.0.3",
    "@soybeanjs/fetch": "^0.1.0",
    "@soybeanjs/utils": "^0.1.1",
    "@ubean/icon": "^0.6.0",
    "@valibot/to-json-schema": "^1.8.0",
    "@vean/aria": "^0.50.0",
    "@vean/theme": "^0.50.0",
    "@vean/ui": "^0.50.0",
    "@vean/unocss": "^0.50.0",
    "@visactor/vchart": "^2.1.7",
    "@visactor/vchart-theme": "^1.13.1",
    "@visactor/vtable-gantt": "^1.26.8",
    "@visactor/vue-vtable": "^1.26.8",
    "@vueuse/core": "^15.0.0",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.0.3",
    "dhtmlx-gantt": "^10.0.3",
    "drizzle-orm": "^0.45.3",
    "echarts": "^6.1.0",
    "jsbarcode": "^3.12.3",
    "pinia": "^4.0.3",
    "pinyin-pro": "^3.29.5",
    "postgres": "^3.4.9",
    "print-js": "^1.6.0",
    "swiper": "^14.3.0",
    "typeit": "^8.8.7",
    "ubean": "^0.6.0",
    "valibot": "^1.5.0",
    "vditor": "^4.0.0",
    "vue": "^3.5.43",
    "vue-draggable-plus": "0.5.6",
    "vue-i18n": "catalog:",
    "vue-pdf-embed": "^2.1.6",
    "vue-router": "^5.3.1",
    "wangeditor": "^4.7.15",
    "xgplayer": "^3.0.26",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@soybeanjs/cli": "^1.8.4",
    "@soybeanjs/eslint-config-vue": "^0.1.1",
    "@soybeanjs/oxc-config": "^0.2.6",
    "@soybeanjs/unocss-preset": "^0.2.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "jsdom": "^30.1.2",
    "playwright": "1.64.0",
    "typescript": "catalog:",
    "unocss": "^66.10.5",
    "vite-plus": "catalog:",
    "vitest": "5.0.3",
    "vue-tsc": "^3.3.12",
    "yaml": "2.9.1"
  },
  "packageManager": "pnpm@12.9.1"
}
