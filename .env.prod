# 生产覆盖项（与 .env 合并；部署时请用真实密钥替换）
#
# 注意 `JWT_SECRET` 没有默认值：留空会让服务在启动期直接抛错（这是刻意的）。
# 生成：openssl rand -base64 48
# 留空不再意味着「用公开占位符签名」—— 那曾让任何人伪造超管 token（审计 1.1）。
JWT_SECRET=
API_BASE_URL=
#
# 多实例部署必填：空值意味着 token 黑名单 / 权限码缓存 / 图形验证码全落在
# 单个进程的内存里。两个实例时 A 登出写进自己的黑名单、B 从未见过该 key，
# 已失效 token 会在 B 上继续有效（审计 1.5）。`src/server.ts` 启动时会告警。
# 单实例部署可以刻意留空。
REDIS_URL=

# 多 baseURL 代理（生产）：key 与 API_PROXY_KEYS 对齐，origin 换成真实上游
API_PROXY_TARGETS=default=https://api.example.com
