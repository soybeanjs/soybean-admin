# ============================================================================
# 规则（P0-D，设计原文 docs/v3.md §5.10）：
#   1. 每个变量的唯一声明处是 `ubean.config.ts` 的 `env.schema` —— 值写在 `.env`，
#      维度（client/server × public/secret）写在 schema。两边都必须有。
#   2. 客户端变量 import `ubean:env/client`，服务端变量 import `ubean:env/server`。
#      本文件的 key **不需要 `VITE_` 前缀**：该虚拟模块由 ubean 的 env 插件直读 `.env`，
#      只认 schema 里声明过的 key。
#   3. 服务端变量被客户端代码 import 时构建会直接失败，不会静默退回 default。
#   4. 同一个变量只声明一次；`.env.prod` 只覆盖值，不新增 key。
# ============================================================================

# ---- 应用元信息（client） ----
APP_TITLE=SoybeanAdmin
APP_DESCRIPTION=A fresh and elegant admin template

# ---- API / 代理（client） ----
# 生产环境后端地址；dev 留空走同源 + 代理
API_BASE_URL=
# dev 代理目标（留空则不启用代理，直接用同进程后端）
API_PROXY=
# 后端多环境前缀，如 /api/v1
API_PREFIX=/api
# 后端多环境标识（local/dev/prod…），随请求带给网关做环境路由（docs/v3.md §4.3）
API_ENV=local
# 多 baseURL 代理的 key（逗号分隔）：请求 /_p/{key}/api/** 由 routeRules.proxy
# 转发到服务端 API_PROXY_TARGETS 里同名 key 的上游；客户端拿不到真实 origin
API_PROXY_KEYS=default

# ---- 主题（client） ----
# 初始主题预设名，需是 `src/store/modules/theme/index.ts` 中 `themePresets` 的 `name`
THEME_PRESET=default

# ---- 路由 / 菜单（client，docs/v3.md §5.3） ----
# static = 本地路由派生菜单；dynamic = GET /api/menu/user 返回菜单 → 菜单驱动路由
AUTH_ROUTE_MODE=static
# 登录后默认首页路径（对齐后端 user.homePath 为空时的兑底）
ROUTE_HOME=/

# ---- 请求层业务码（client，docs/v3.md §5.4；与服务端 src/constants/error-code.ts 对齐） ----
SERVICE_SUCCESS_CODE=0000
# 收到即静默登出：未授权 / 令牌无效 / 令牌拉黑 / 刷新令牌三态 / 用户禁用
SERVICE_LOGOUT_CODES=2000,2002,2003,2004,2005,2006,2008
# 收到即弹窗确认后登出：未授权 / 令牌无效 / 令牌拉黑
SERVICE_MODAL_LOGOUT_CODES=2000,2002,2003
# 令牌过期码（触发单飞刷新 + 请求重放）
SERVICE_EXPIRED_TOKEN_CODES=2001
# static 模式下拥有全部权限的超级角色码
STATIC_SUPER_ROLE=super
# localStorage key 前缀
STORAGE_PREFIX=@soybean/

# ---- 服务端（server） ----
SERVER_HOST=0.0.0.0
SERVER_PORT=9527
# 服务端内部回环地址（seed / cron / server action 直调自身时使用）
SERVER_INTERNAL_URL=http://127.0.0.1:9527

# 多 baseURL 代理上游（server，`key=origin` 逗号分隔，origin 不含路径）。
# 与 API_PROXY_KEYS 的 key 一一对应；dev 默认指回本进程，便于自代理验证。
# 必须写 localhost：dev server 实际只监听 `[::1]:9527`（Vite 的 host 解析结果，
# 与日志里的 SERVER_HOST 无关），写 127.0.0.1 会被拒连（fetch failed → 业务码 1000）。
API_PROXY_TARGETS=default=http://localhost:9527

# ---- 鉴权（server） ----
JWT_SECRET=soybean-admin-v3-dev-secret-change-me
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_EXPIRES_IN=7d

# ---- 数据库 / 缓存（server） ----
# SQLite 文件（file: 前缀，目录会自动创建）；生产换 postgres 连接串
DATABASE_URL=file:./.data/dev.sqlite3
# 留空则用进程内存缓存（dev 默认）
REDIS_URL=
