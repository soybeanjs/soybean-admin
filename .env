# ============================================================================
# 规则（见 docs/v3.md §5.10）：
#   1. 客户端可见变量以 VITE_ 开头 -> src/env.ts 的 `import.meta.env`（Vite 原生注入）
#      不要走 ubean defineEnv 的 public 段：defineEnv 只读 process.env，
#      浏览器里拿不到真实值，只会退回 default
#   2. 服务端变量不加前缀 -> src/env.server.ts 的 defineEnv({ server })，启动期校验
#   3. 同一个变量不要同时出现在两条路径上
# ============================================================================

# ---- 应用元信息（public） ----
VITE_APP_TITLE=SoybeanAdmin
VITE_APP_DESCRIPTION=A fresh and elegant admin template

# ---- API / 代理（public） ----
# 生产环境后端地址；dev 留空走同源 + 代理
VITE_API_BASE_URL=
# dev 代理目标（留空则不启用代理，直接用同进程后端）
VITE_API_PROXY=
# 后端多环境前缀，如 /api/v1
VITE_API_PREFIX=/api
# 后端多环境标识（local/dev/prod…），随请求带给网关做环境路由（docs/v3.md §4.3）
VITE_API_ENV=local
# 多 baseURL 代理的 key（逗号分隔）：请求 /_p/{key}/api/** 由 routeRules.proxy
# 转发到服务端 API_PROXY_TARGETS 里同名 key 的上游；客户端拿不到真实 origin
VITE_API_PROXY_KEYS=default

# ---- 主题（public） ----
# 初始主题预设名，需是 `src/store/modules/theme/index.ts` 中 `themePresets` 的 `name`
VITE_THEME_PRESET=default

# ---- 路由 / 菜单（public，docs/v3.md §5.3） ----
# static = 本地路由派生菜单；dynamic = GET /api/menu/user 返回菜单 → 菜单驱动路由
VITE_AUTH_ROUTE_MODE=static
# 登录后默认首页路径（对齐后端 user.homePath 为空时的兑底）
VITE_ROUTE_HOME=/

# ---- 请求层业务码（public，docs/v3.md §5.4；与服务端 src/constants/error-code.ts 对齐） ----
VITE_SERVICE_SUCCESS_CODE=0000
# 收到即静默登出：未授权 / 令牌无效 / 令牌拉黑 / 刷新令牌三态 / 用户禁用
VITE_SERVICE_LOGOUT_CODES=2000,2002,2003,2004,2005,2006,2008
# 收到即弹窗确认后登出：未授权 / 令牌无效 / 令牌拉黑
VITE_SERVICE_MODAL_LOGOUT_CODES=2000,2002,2003
# 令牌过期码（触发单飞刷新 + 请求重放）
VITE_SERVICE_EXPIRED_TOKEN_CODES=2001
# static 模式下拥有全部权限的超级角色码
VITE_STATIC_SUPER_ROLE=super
# localStorage key 前缀
VITE_STORAGE_PREFIX=@soybean/

# ---- 服务端（server） ----
SERVER_HOST=0.0.0.0
SERVER_PORT=9527
# 服务端内部回环地址（seed / cron / server action 直调自身时使用）
SERVER_INTERNAL_URL=http://127.0.0.1:9527

# 多 baseURL 代理上游（server，`key=origin` 逗号分隔，origin 不含路径）。
# 与 VITE_API_PROXY_KEYS 的 key 一一对应；dev 默认指回本进程，便于自代理验证。
# 必须写 localhost：dev server 实际只监听 `[::1]:9527`（Vite 的 host 解析结果，
# 与日志里的 SERVER_HOST 无关），写 127.0.0.1 会被拒连（fetch failed → 业务码 1000）。
API_PROXY_TARGETS=default=http://localhost:9527

# ---- 鉴权（server） ----
JWT_SECRET=soybean-admin-v3-dev-secret-change-me
JWT_EXPIRES_IN=1d
REFRESH_TOKEN_EXPIRES_IN=7d

# ---- 数据库 / 缓存（server） ----
# SQLite 文件（file: 前缀，目录会自动创建）；生产换 postgres 连接串
DATABASE_URL=file:./.data/dev.sqlite3
# 留空则用进程内存缓存（dev 默认）
REDIS_URL=
